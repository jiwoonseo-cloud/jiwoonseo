Dialogue: 1,0:00:00.05,0:00:01.86,Main,,0,0,0,,{\pos(540,1267)}로봇청소기 쓰시는 분들,
Dialogue: 1,0:00:01.86,0:00:03.19,Main,,0,0,0,,{\pos(540,1267)}이런 적 있으시죠?
Dialogue: 1,0:00:03.42,0:00:04.92,Main,,0,0,0,,{\pos(540,1267)}청소 끝나고 브러시
Dialogue: 1,0:00:04.92,0:00:06.50,Main,,0,0,0,,{\pos(540,1267)}뒤집었더니, 머리카락이
Dialogue: 1,0:00:06.50,0:00:07.50,Main,,0,0,0,,{\pos(540,1267)}축에 칭칭 감겨
Dialogue: 1,0:00:07.50,0:00:08.56,Main,,0,0,0,,{\pos(540,1267)}있는 경우요.
Dialogue: 1,0:00:08.86,0:00:09.61,Main,,0,0,0,,{\pos(540,1267)}고장 난 게
Dialogue: 1,0:00:09.61,0:00:10.14,Main,,0,0,0,,{\pos(540,1267)}아닙니다.
Dialogue: 1,0:00:10.14,0:00:11.41,Main,,0,0,0,,{\pos(540,1267)}흡입력이 약해서도
Dialogue: 1,0:00:11.41,0:00:12.61,Main,,0,0,0,,{\pos(540,1267)}아니고요.
Dialogue: 1,0:00:12.61,0:00:14.05,Main,,0,0,0,,{\pos(540,1267)}원인은 바닥에 닿아서
Dialogue: 1,0:00:14.05,0:00:15.88,Main,,0,0,0,,{\pos(540,1267)}도는 롤러 브러시예요.
Dialogue: 1,0:00:15.88,0:00:16.76,Main,,0,0,0,,{\pos(540,1267)}이 롤러가 실을
Dialogue: 1,0:00:16.76,0:00:18.36,Main,,0,0,0,,{\pos(540,1267)}감는 실패처럼 머리카락을
Dialogue: 1,0:00:18.36,0:00:19.18,Main,,0,0,0,,{\pos(540,1267)}축 방향으로 밀어
Dialogue: 1,0:00:19.18,0:00:20.04,Main,,0,0,0,,{\pos(540,1267)}버리거든요.
Dialogue: 1,0:00:20.33,0:00:21.70,Main,,0,0,0,,{\pos(540,1267)}롤러가 돌아가면 긴
Dialogue: 1,0:00:21.70,0:00:22.41,Main,,0,0,0,,{\pos(540,1267)}머리카락이 모에
Dialogue: 1,0:00:22.41,0:00:23.10,Main,,0,0,0,,{\pos(540,1267)}걸립니다.
Dialogue: 1,0:00:23.10,0:00:24.17,Main,,0,0,0,,{\pos(540,1267)}한 번 걸리면
Dialogue: 1,0:00:24.17,0:00:25.56,Main,,0,0,0,,{\pos(540,1267)}회전할 때마다 더
Dialogue: 1,0:00:25.56,0:00:26.91,Main,,0,0,0,,{\pos(540,1267)}세게 감기고, 가운데에
Dialogue: 1,0:00:26.91,0:00:27.69,Main,,0,0,0,,{\pos(540,1267)}머물지 않아요.
Dialogue: 1,0:00:27.69,0:00:29.14,Main,,0,0,0,,{\pos(540,1267)}저항이 적은 끝단,
Dialogue: 1,0:00:29.14,0:00:30.25,Main,,0,0,0,,{\pos(540,1267)}베어링 쪽으로 미끄러져
Dialogue: 1,0:00:30.25,0:00:31.38,Main,,0,0,0,,{\pos(540,1267)}모입니다.
Dialogue: 1,0:00:31.38,0:00:32.88,Main,,0,0,0,,{\pos(540,1267)}짧은 털은 흡입으로
Dialogue: 1,0:00:32.88,0:00:34.56,Main,,0,0,0,,{\pos(540,1267)}빨려 올라가지만, 길이가
Dialogue: 1,0:00:34.56,0:00:35.65,Main,,0,0,0,,{\pos(540,1267)}긴 머리카락은 한
Dialogue: 1,0:00:35.65,0:00:36.36,Main,,0,0,0,,{\pos(540,1267)}바퀴를 다 돌
Dialogue: 1,0:00:36.36,0:00:37.17,Main,,0,0,0,,{\pos(540,1267)}수 있어서 축에
Dialogue: 1,0:00:37.17,0:00:38.14,Main,,0,0,0,,{\pos(540,1267)}남는 거예요.
Dialogue: 1,0:00:38.43,0:00:39.86,Main,,0,0,0,,{\pos(540,1267)}그래서 브러시 가운데는
Dialogue: 1,0:00:39.86,0:00:41.13,Main,,0,0,0,,{\pos(540,1267)}깨끗해 보여도, 양끝
Dialogue: 1,0:00:41.13,0:00:41.94,Main,,0,0,0,,{\pos(540,1267)}캡을 열어 보면
Dialogue: 1,0:00:41.94,0:00:43.46,Main,,0,0,0,,{\pos(540,1267)}머리카락이 두껍게 감겨
Dialogue: 1,0:00:43.46,0:00:44.99,Main,,0,0,0,,{\pos(540,1267)}있는 경우가 많아요.
Dialogue: 1,0:00:44.99,0:00:46.27,Main,,0,0,0,,{\pos(540,1267)}로보락 같은 브랜드들도
Dialogue: 1,0:00:46.27,0:00:47.90,Main,,0,0,0,,{\pos(540,1267)}브러시 끝단과 베어링을
Dialogue: 1,0:00:47.90,0:00:49.01,Main,,0,0,0,,{\pos(540,1267)}정기적으로 확인하라고
Dialogue: 1,0:00:49.01,0:00:50.22,Main,,0,0,0,,{\pos(540,1267)}안내합니다.
Dialogue: 1,0:00:50.22,0:00:51.88,Main,,0,0,0,,{\pos(540,1267)}너무 쌓이면 모터에
Dialogue: 1,0:00:51.88,0:00:53.41,Main,,0,0,0,,{\pos(540,1267)}부하가 걸리고 브러시가
Dialogue: 1,0:00:53.41,0:00:54.23,Main,,0,0,0,,{\pos(540,1267)}손상될 수 있다고
Dialogue: 1,0:00:54.23,0:00:54.92,Main,,0,0,0,,{\pos(540,1267)}해요.
Dialogue: 1,0:00:55.20,0:00:56.57,Main,,0,0,0,,{\pos(540,1267)}그럼 흡입력을 더
Dialogue: 1,0:00:56.57,0:00:57.38,Main,,0,0,0,,{\pos(540,1267)}세게 하면 되지
Dialogue: 1,0:00:57.38,0:00:58.39,Main,,0,0,0,,{\pos(540,1267)}않냐고요?
Dialogue: 1,0:00:58.63,0:00:59.86,Main,,0,0,0,,{\pos(540,1267)}흡입력은 이미 떠
Dialogue: 1,0:00:59.86,0:01:00.92,Main,,0,0,0,,{\pos(540,1267)}있는 먼지를 빨아들이는
Dialogue: 1,0:01:00.92,0:01:01.72,Main,,0,0,0,,{\pos(540,1267)}일이에요.
Dialogue: 1,0:01:01.72,0:01:03.18,Main,,0,0,0,,{\pos(540,1267)}머리카락이 롤러에 한
Dialogue: 1,0:01:03.18,0:01:04.27,Main,,0,0,0,,{\pos(540,1267)}번 감기기 시작하면,
Dialogue: 1,0:01:04.27,0:01:05.94,Main,,0,0,0,,{\pos(540,1267)}회전이 흡입보다 먼저
Dialogue: 1,0:01:05.94,0:01:07.10,Main,,0,0,0,,{\pos(540,1267)}작동해서 축으로 밀어
Dialogue: 1,0:01:07.10,0:01:08.33,Main,,0,0,0,,{\pos(540,1267)}넣습니다.
Dialogue: 1,0:01:08.33,0:01:10.08,Main,,0,0,0,,{\pos(540,1267)}그래서 흡입력 숫자만
Dialogue: 1,0:01:10.08,0:01:11.59,Main,,0,0,0,,{\pos(540,1267)}올려서는 감김이 사라지지
Dialogue: 1,0:01:11.59,0:01:12.44,Main,,0,0,0,,{\pos(540,1267)}않아요.
Dialogue: 1,0:01:12.75,0:01:14.22,Main,,0,0,0,,{\pos(540,1267)}그래서 브랜드들이 구조를
Dialogue: 1,0:01:14.22,0:01:15.33,Main,,0,0,0,,{\pos(540,1267)}바꿨습니다.
Dialogue: 1,0:01:15.33,0:01:16.94,Main,,0,0,0,,{\pos(540,1267)}로보락은 짧은 롤러
Dialogue: 1,0:01:16.94,0:01:17.63,Main,,0,0,0,,{\pos(540,1267)}두 개를 반대
Dialogue: 1,0:01:17.63,0:01:18.50,Main,,0,0,0,,{\pos(540,1267)}방향으로 돌려,
Dialogue: 1,0:01:18.50,0:01:19.95,Main,,0,0,0,,{\pos(540,1267)}머리카락을 양쪽에서
Dialogue: 1,0:01:19.95,0:01:20.96,Main,,0,0,0,,{\pos(540,1267)}가운데로 밀어 넣고
Dialogue: 1,0:01:20.96,0:01:22.50,Main,,0,0,0,,{\pos(540,1267)}바로 빨아들이는 구조를
Dialogue: 1,0:01:22.50,0:01:23.64,Main,,0,0,0,,{\pos(540,1267)}씁니다.
Dialogue: 1,0:01:23.64,0:01:25.70,Main,,0,0,0,,{\pos(540,1267)}드리미나 나르왈은 절단
Dialogue: 1,0:01:25.70,0:01:27.04,Main,,0,0,0,,{\pos(540,1267)}구조로 머리카락이 축까지
Dialogue: 1,0:01:27.04,0:01:28.00,Main,,0,0,0,,{\pos(540,1267)}가지 못하게 경로를
Dialogue: 1,0:01:28.00,0:01:29.12,Main,,0,0,0,,{\pos(540,1267)}바꿉니다.
Dialogue: 1,0:01:29.12,0:01:31.20,Main,,0,0,0,,{\pos(540,1267)}공통점은 흡입력을 올리는
Dialogue: 1,0:01:31.20,0:01:32.27,Main,,0,0,0,,{\pos(540,1267)}대신, 경로를 바꾼
Dialogue: 1,0:01:32.27,0:01:32.96,Main,,0,0,0,,{\pos(540,1267)}거예요.
Dialogue: 1,0:01:33.27,0:01:34.57,Main,,0,0,0,,{\pos(540,1267)}그런데 이 구조도
Dialogue: 1,0:01:34.57,0:01:35.53,Main,,0,0,0,,{\pos(540,1267)}완벽하진 않아요.
Dialogue: 1,0:01:35.53,0:01:37.04,Main,,0,0,0,,{\pos(540,1267)}긴 머리카락이 많거나
Dialogue: 1,0:01:37.04,0:01:38.53,Main,,0,0,0,,{\pos(540,1267)}반려동물이 있는 집에서는
Dialogue: 1,0:01:38.53,0:01:40.44,Main,,0,0,0,,{\pos(540,1267)}여전히 끝단에 쌓입니다.
Dialogue: 1,0:01:40.44,0:01:42.10,Main,,0,0,0,,{\pos(540,1267)}구조가 감김을 줄여
Dialogue: 1,0:01:42.10,0:01:42.71,Main,,0,0,0,,{\pos(540,1267)}줄 뿐, 없애
Dialogue: 1,0:01:42.71,0:01:43.65,Main,,0,0,0,,{\pos(540,1267)}주지는 않거든요.
Dialogue: 1,0:01:43.65,0:01:45.29,Main,,0,0,0,,{\pos(540,1267)}회전하는 롤러 자체가
Dialogue: 1,0:01:45.29,0:01:46.64,Main,,0,0,0,,{\pos(540,1267)}머리카락을 끝단으로
Dialogue: 1,0:01:46.64,0:01:47.85,Main,,0,0,0,,{\pos(540,1267)}미끄러지게 하는 원리는
Dialogue: 1,0:01:47.85,0:01:48.79,Main,,0,0,0,,{\pos(540,1267)}그대로 남아 있기
Dialogue: 1,0:01:48.79,0:01:49.81,Main,,0,0,0,,{\pos(540,1267)}때문입니다.
Dialogue: 1,0:01:50.11,0:01:51.61,Main,,0,0,0,,{\pos(540,1267)}결국 핵심은 흡입력이
Dialogue: 1,0:01:51.61,0:01:52.97,Main,,0,0,0,,{\pos(540,1267)}아니라, 회전하는 롤러가
Dialogue: 1,0:01:52.97,0:01:54.03,Main,,0,0,0,,{\pos(540,1267)}머리카락을 끝단으로
Dialogue: 1,0:01:54.03,0:01:55.05,Main,,0,0,0,,{\pos(540,1267)}미끄러지게 하는 물리
Dialogue: 1,0:01:55.05,0:01:55.63,Main,,0,0,0,,{\pos(540,1267)}자체예요.
Dialogue: 1,0:01:55.63,0:01:57.33,Main,,0,0,0,,{\pos(540,1267)}청소가 끝나면 브러시를
Dialogue: 1,0:01:57.33,0:01:58.48,Main,,0,0,0,,{\pos(540,1267)}꺼내서 양끝 캡을
Dialogue: 1,0:01:58.48,0:01:59.70,Main,,0,0,0,,{\pos(540,1267)}열어 보세요.
Dialogue: 1,0:01:59.70,0:02:00.83,Main,,0,0,0,,{\pos(540,1267)}일주일에 한 번,
Dialogue: 1,0:02:00.83,0:02:01.77,Main,,0,0,0,,{\pos(540,1267)}머리카락이 많거나
Dialogue: 1,0:02:01.77,0:02:02.86,Main,,0,0,0,,{\pos(540,1267)}반려동물이 있는 집은
Dialogue: 1,0:02:02.86,0:02:04.42,Main,,0,0,0,,{\pos(540,1267)}두 번이면 충분합니다.
Dialogue: 1,0:02:04.42,0:02:05.56,Main,,0,0,0,,{\pos(540,1267)}끝단에 감겨 있으면
Dialogue: 1,0:02:05.56,0:02:07.01,Main,,0,0,0,,{\pos(540,1267)}가위나 도구로 잘라
Dialogue: 1,0:02:07.01,0:02:07.84,Main,,0,0,0,,{\pos(540,1267)}빼는 게 모터를
Dialogue: 1,0:02:07.84,0:02:09.00,Main,,0,0,0,,{\pos(540,1267)}지키는 가장 빠른
Dialogue: 1,0:02:09.00,0:02:10.08,Main,,0,0,0,,{\pos(540,1267)}방법입니다.
Dialogue: 0,0:00:00.00,0:02:10.32,Note,,0,0,0,,{\pos(540,1510)}원리 시각화 연출, 특정 제품 아님
