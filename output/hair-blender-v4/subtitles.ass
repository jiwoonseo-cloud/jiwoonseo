Dialogue: 0,0:00:00.05,0:00:02.00,Default,,0,0,0,,{\pos(540,1267)}로봇청소기 쓰시는 분들,
Dialogue: 0,0:00:02.29,0:00:03.61,Default,,0,0,0,,{\pos(540,1267)}이런 적 있으시죠?
Dialogue: 0,0:00:03.95,0:00:05.42,Default,,0,0,0,,{\pos(540,1267)}청소 끝나고 브러시
Dialogue: 0,0:00:05.42,0:00:06.35,Default,,0,0,0,,{\pos(540,1267)}뒤집었더니,
Dialogue: 0,0:00:06.71,0:00:08.32,Default,,0,0,0,,{\pos(540,1267)}머리카락이 축에 칭칭
Dialogue: 0,0:00:08.32,0:00:09.56,Default,,0,0,0,,{\pos(540,1267)}감겨 있는 경우요.
Dialogue: 0,0:00:09.96,0:00:10.90,Default,,0,0,0,,{\pos(540,1267)}고장 난 게
Dialogue: 0,0:00:10.90,0:00:11.90,Default,,0,0,0,,{\pos(540,1267)}아닙니다.
Dialogue: 0,0:00:12.24,0:00:13.70,Default,,0,0,0,,{\pos(540,1267)}흡입력이 약해서도
Dialogue: 0,0:00:13.70,0:00:14.60,Default,,0,0,0,,{\pos(540,1267)}아니고요.
Dialogue: 0,0:00:14.94,0:00:16.69,Default,,0,0,0,,{\pos(540,1267)}원인은 바닥에 닿아서
Dialogue: 0,0:00:16.69,0:00:18.40,Default,,0,0,0,,{\pos(540,1267)}도는 롤러 브러시예요.
Dialogue: 0,0:00:18.74,0:00:19.96,Default,,0,0,0,,{\pos(540,1267)}이 롤러가 실을
Dialogue: 0,0:00:19.96,0:00:21.94,Default,,0,0,0,,{\pos(540,1267)}감는 실패처럼 머리카락을
Dialogue: 0,0:00:21.94,0:00:23.02,Default,,0,0,0,,{\pos(540,1267)}축 방향으로 밀어
Dialogue: 0,0:00:23.02,0:00:23.94,Default,,0,0,0,,{\pos(540,1267)}버리거든요.
Dialogue: 0,0:00:24.34,0:00:26.01,Default,,0,0,0,,{\pos(540,1267)}롤러가 돌아가면 긴
Dialogue: 0,0:00:26.01,0:00:27.11,Default,,0,0,0,,{\pos(540,1267)}머리카락이 모에
Dialogue: 0,0:00:27.11,0:00:28.16,Default,,0,0,0,,{\pos(540,1267)}걸립니다.
Dialogue: 0,0:00:28.50,0:00:29.43,Default,,0,0,0,,{\pos(540,1267)}한 번 걸리면
Dialogue: 0,0:00:29.43,0:00:30.70,Default,,0,0,0,,{\pos(540,1267)}회전할 때마다 더
Dialogue: 0,0:00:30.70,0:00:31.76,Default,,0,0,0,,{\pos(540,1267)}세게 감기고,
Dialogue: 0,0:00:32.06,0:00:33.95,Default,,0,0,0,,{\pos(540,1267)}가운데에 머물지 않아요.
Dialogue: 0,0:00:34.29,0:00:35.71,Default,,0,0,0,,{\pos(540,1267)}저항이 적은 끝단,
Dialogue: 0,0:00:36.08,0:00:37.64,Default,,0,0,0,,{\pos(540,1267)}베어링 쪽으로 미끄러져
Dialogue: 0,0:00:37.64,0:00:38.38,Default,,0,0,0,,{\pos(540,1267)}모입니다.
Dialogue: 0,0:00:38.71,0:00:40.04,Default,,0,0,0,,{\pos(540,1267)}짧은 털은 흡입으로
Dialogue: 0,0:00:40.04,0:00:41.23,Default,,0,0,0,,{\pos(540,1267)}빨려 올라가지만,
Dialogue: 0,0:00:41.49,0:00:43.01,Default,,0,0,0,,{\pos(540,1267)}길이가 긴 머리카락은
Dialogue: 0,0:00:43.01,0:00:43.95,Default,,0,0,0,,{\pos(540,1267)}한 바퀴를 다
Dialogue: 0,0:00:43.95,0:00:44.79,Default,,0,0,0,,{\pos(540,1267)}돌 수 있어서
Dialogue: 0,0:00:44.79,0:00:46.23,Default,,0,0,0,,{\pos(540,1267)}축에 남는 거예요.
Dialogue: 0,0:00:46.63,0:00:48.10,Default,,0,0,0,,{\pos(540,1267)}그래서 브러시 가운데는
Dialogue: 0,0:00:48.10,0:00:49.20,Default,,0,0,0,,{\pos(540,1267)}깨끗해 보여도,
Dialogue: 0,0:00:49.48,0:00:50.43,Default,,0,0,0,,{\pos(540,1267)}양끝 캡을 열어
Dialogue: 0,0:00:50.43,0:00:52.26,Default,,0,0,0,,{\pos(540,1267)}보면 머리카락이 두껍게
Dialogue: 0,0:00:52.26,0:00:53.16,Default,,0,0,0,,{\pos(540,1267)}감겨 있는 경우가
Dialogue: 0,0:00:53.16,0:00:54.17,Default,,0,0,0,,{\pos(540,1267)}많아요.
Dialogue: 0,0:00:54.51,0:00:56.17,Default,,0,0,0,,{\pos(540,1267)}로보락 같은 브랜드들도
Dialogue: 0,0:00:56.17,0:00:58.33,Default,,0,0,0,,{\pos(540,1267)}브러시 끝단과 베어링을
Dialogue: 0,0:00:58.33,0:00:59.78,Default,,0,0,0,,{\pos(540,1267)}정기적으로 확인하라고
Dialogue: 0,0:00:59.78,0:01:00.90,Default,,0,0,0,,{\pos(540,1267)}안내합니다.
Dialogue: 0,0:01:01.23,0:01:02.81,Default,,0,0,0,,{\pos(540,1267)}너무 쌓이면 모터에
Dialogue: 0,0:01:02.81,0:01:04.75,Default,,0,0,0,,{\pos(540,1267)}부하가 걸리고 브러시가
Dialogue: 0,0:01:04.75,0:01:05.73,Default,,0,0,0,,{\pos(540,1267)}손상될 수 있다고
Dialogue: 0,0:01:05.73,0:01:06.53,Default,,0,0,0,,{\pos(540,1267)}해요.
Dialogue: 0,0:01:06.94,0:01:08.45,Default,,0,0,0,,{\pos(540,1267)}그럼 흡입력을 더
Dialogue: 0,0:01:08.45,0:01:09.34,Default,,0,0,0,,{\pos(540,1267)}세게 하면 되지
Dialogue: 0,0:01:09.34,0:01:10.38,Default,,0,0,0,,{\pos(540,1267)}않냐고요?
Dialogue: 0,0:01:10.71,0:01:12.11,Default,,0,0,0,,{\pos(540,1267)}흡입력은 이미 떠
Dialogue: 0,0:01:12.11,0:01:13.51,Default,,0,0,0,,{\pos(540,1267)}있는 먼지를 빨아들이는
Dialogue: 0,0:01:13.51,0:01:14.28,Default,,0,0,0,,{\pos(540,1267)}일이에요.
Dialogue: 0,0:01:14.61,0:01:16.05,Default,,0,0,0,,{\pos(540,1267)}머리카락이 롤러에 한
Dialogue: 0,0:01:16.05,0:01:17.43,Default,,0,0,0,,{\pos(540,1267)}번 감기기 시작하면,
Dialogue: 0,0:01:17.68,0:01:19.24,Default,,0,0,0,,{\pos(540,1267)}회전이 흡입보다 먼저
Dialogue: 0,0:01:19.24,0:01:20.66,Default,,0,0,0,,{\pos(540,1267)}작동해서 축으로 밀어
Dialogue: 0,0:01:20.66,0:01:21.68,Default,,0,0,0,,{\pos(540,1267)}넣습니다.
Dialogue: 0,0:01:22.01,0:01:23.55,Default,,0,0,0,,{\pos(540,1267)}그래서 흡입력 숫자만
Dialogue: 0,0:01:23.55,0:01:25.39,Default,,0,0,0,,{\pos(540,1267)}올려서는 감김이 사라지지
Dialogue: 0,0:01:25.39,0:01:26.24,Default,,0,0,0,,{\pos(540,1267)}않아요.
Dialogue: 0,0:01:26.64,0:01:28.19,Default,,0,0,0,,{\pos(540,1267)}그런데 이 구조도
Dialogue: 0,0:01:28.19,0:01:29.59,Default,,0,0,0,,{\pos(540,1267)}완벽하진 않아요.
Dialogue: 0,0:01:29.93,0:01:31.57,Default,,0,0,0,,{\pos(540,1267)}긴 머리카락이 많거나
Dialogue: 0,0:01:31.57,0:01:33.39,Default,,0,0,0,,{\pos(540,1267)}반려동물이 있는 집에서는
Dialogue: 0,0:01:33.39,0:01:35.45,Default,,0,0,0,,{\pos(540,1267)}여전히 끝단에 쌓입니다.
Dialogue: 0,0:01:35.79,0:01:37.12,Default,,0,0,0,,{\pos(540,1267)}구조가 감김을 줄여
Dialogue: 0,0:01:37.12,0:01:37.77,Default,,0,0,0,,{\pos(540,1267)}줄 뿐,
Dialogue: 0,0:01:38.15,0:01:39.82,Default,,0,0,0,,{\pos(540,1267)}없애 주지는 않거든요.
Dialogue: 0,0:01:40.15,0:01:41.85,Default,,0,0,0,,{\pos(540,1267)}회전하는 롤러 자체가
Dialogue: 0,0:01:41.85,0:01:43.29,Default,,0,0,0,,{\pos(540,1267)}머리카락을 끝단으로
Dialogue: 0,0:01:43.29,0:01:44.74,Default,,0,0,0,,{\pos(540,1267)}미끄러지게 하는 원리는
Dialogue: 0,0:01:44.74,0:01:45.90,Default,,0,0,0,,{\pos(540,1267)}그대로 남아 있기
Dialogue: 0,0:01:45.90,0:01:47.00,Default,,0,0,0,,{\pos(540,1267)}때문입니다.
Dialogue: 0,0:01:47.40,0:01:49.00,Default,,0,0,0,,{\pos(540,1267)}결국 핵심은 흡입력이
Dialogue: 0,0:01:49.00,0:01:49.60,Default,,0,0,0,,{\pos(540,1267)}아니라,
Dialogue: 0,0:01:49.84,0:01:51.01,Default,,0,0,0,,{\pos(540,1267)}회전하는 롤러가
Dialogue: 0,0:01:51.01,0:01:52.36,Default,,0,0,0,,{\pos(540,1267)}머리카락을 끝단으로
Dialogue: 0,0:01:52.36,0:01:53.71,Default,,0,0,0,,{\pos(540,1267)}미끄러지게 하는 물리
Dialogue: 0,0:01:53.71,0:01:54.70,Default,,0,0,0,,{\pos(540,1267)}자체예요.
Dialogue: 0,0:01:55.04,0:01:56.78,Default,,0,0,0,,{\pos(540,1267)}청소가 끝나면 브러시를
Dialogue: 0,0:01:56.78,0:01:58.34,Default,,0,0,0,,{\pos(540,1267)}꺼내서 양끝 캡을
Dialogue: 0,0:01:58.34,0:01:59.55,Default,,0,0,0,,{\pos(540,1267)}열어 보세요.
Dialogue: 0,0:01:59.89,0:02:01.16,Default,,0,0,0,,{\pos(540,1267)}일주일에 한 번,
Dialogue: 0,0:02:01.40,0:02:02.63,Default,,0,0,0,,{\pos(540,1267)}머리카락이 많거나
Dialogue: 0,0:02:02.63,0:02:03.99,Default,,0,0,0,,{\pos(540,1267)}반려동물이 있는 집은
Dialogue: 0,0:02:03.99,0:02:06.04,Default,,0,0,0,,{\pos(540,1267)}두 번이면 충분합니다.
Dialogue: 0,0:02:06.38,0:02:07.84,Default,,0,0,0,,{\pos(540,1267)}끝단에 감겨 있으면
Dialogue: 0,0:02:07.84,0:02:09.34,Default,,0,0,0,,{\pos(540,1267)}가위나 도구로 잘라
Dialogue: 0,0:02:09.34,0:02:10.26,Default,,0,0,0,,{\pos(540,1267)}빼는 게 모터를
Dialogue: 0,0:02:10.26,0:02:11.78,Default,,0,0,0,,{\pos(540,1267)}지키는 가장 빠른
Dialogue: 0,0:02:11.78,0:02:12.90,Default,,0,0,0,,{\pos(540,1267)}방법입니다.
