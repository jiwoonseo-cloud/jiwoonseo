[
  {
    "id": 0,
    "text": "초음파 가습기를 켰더니, 공기청정기가 빨갛게 변합니다.",
    "start": 0,
    "duration": 4.0416326530612245
  },
  {
    "id": 1,
    "text": "맑은 물만 넣었는데, 먼지는 대체 어디서 나온 걸까요?",
    "start": 4.0416326530612245,
    "duration": 3.791655328798186
  },
  {
    "id": 2,
    "text": "먼저 저 하얀 분무를 확대해보죠.",
    "start": 7.83328798185941,
    "duration": 2.416643990929705
  },
  {
    "id": 3,
    "text": "초음파 가습기는 물을 진동시켜 아주 작은 물방울로 쪼개 날려 보냅니다.",
    "start": 10.249931972789115,
    "duration": 5.291655328798186
  },
  {
    "id": 4,
    "text": "눈앞에 떠 있는 건 기체인 수증기가 아니라, 작은 액체 방울들이에요.",
    "start": 15.5415873015873,
    "duration": 4.166666666666667
  },
  {
    "id": 5,
    "text": "이 물방울이 공기청정기의 먼지 센서로 들어갑니다.",
    "start": 19.708253968253967,
    "duration": 3.874965986394558
  },
  {
    "id": 6,
    "text": "광학식 센서 안에는 빛이 지나가는 통로가 있습니다.",
    "start": 23.583219954648523,
    "duration": 3.708299319727891
  },
  {
    "id": 7,
    "text": "먼지 같은 입자가 그 빛을 지나면 빛이 사방으로 흩어지고,",
    "start": 27.291519274376416,
    "duration": 4.2082993197278915
  },
  {
    "id": 8,
    "text": "센서는 그 신호를 이용해 먼지 농도를 계산하죠.",
    "start": 31.49981859410431,
    "duration": 3.8333333333333335
  },
  {
    "id": 9,
    "text": "그런데 물방울도 빛을 흩뜨립니다.",
    "start": 35.33315192743764,
    "duration": 2.791655328798186
  },
  {
    "id": 10,
    "text": "센서가 그 성분까지 검사하는 건 아니거든요.",
    "start": 38.124807256235826,
    "duration": 3.083310657596372
  },
  {
    "id": 11,
    "text": "그래서 가습기가 내보낸 물방울 때문에, 표시창의 먼지 수치가 올라갈 수 있습니다.",
    "start": 41.2081179138322,
    "duration": 5.666666666666667
  },
  {
    "id": 12,
    "text": "그럼 물방울이 마르면 전부 사라질까요?",
    "start": 46.87478458049886,
    "duration": 2.9583219954648525
  },
  {
    "id": 13,
    "text": "여기서 물속에 녹아 있던 성분이 등장합니다.",
    "start": 49.83310657596371,
    "duration": 3.4583219954648525
  },
  {
    "id": 14,
    "text": "수돗물에는 칼슘 같은 미네랄이 녹아 있어요.",
    "start": 53.29142857142856,
    "duration": 3.374965986394558
  },
  {
    "id": 15,
    "text": "초음파 가습기는 물만 골라 내보내지 않습니다.",
    "start": 56.66639455782312,
    "duration": 3.583310657596372
  },
  {
    "id": 16,
    "text": "물방울에 실린 미네랄도 함께 공기 중으로 나갈 수 있죠.",
    "start": 60.24970521541949,
    "duration": 3.6666666666666665
  },
  {
    "id": 17,
    "text": "이때 물이 증발하면, 미네랄은 작은 고체 입자로 남을 수 있습니다.",
    "start": 63.91637188208615,
    "duration": 4.4583219954648525
  },
  {
    "id": 18,
    "text": "젖어 있을 땐 안 보이던 물자국이, 마르고 나면 하얗게 남는 것처럼요.",
    "start": 68.37469387755101,
    "duration": 5.0
  },
  {
    "id": 19,
    "text": "처음의 빨간불로 돌아가 보죠.",
    "start": 73.37469387755101,
    "duration": 2.2499773242630385
  },
  {
    "id": 20,
    "text": "물방울 자체가 센서에 잡히는 것과,",
    "start": 75.62467120181405,
    "duration": 2.5416326530612245
  },
  {
    "id": 21,
    "text": "물이 마른 뒤 입자가 남는 것은 서로 다른 과정입니다.",
    "start": 78.16630385487528,
    "duration": 3.916643990929705
  },
  {
    "id": 22,
    "text": "표시창의 숫자만으로 그 성분이나 위험성까지 알 수는 없어요.",
    "start": 82.08294784580498,
    "duration": 4.1249886621315195
  },
  {
    "id": 23,
    "text": "하지만 두 기기가 왜 충돌하는 것처럼 보이는지는 분명해집니다.",
    "start": 86.2079365079365,
    "duration": 4.5
  },
  {
    "id": 24,
    "text": "하나는 물을 작은 방울로 만들어 내보내고,",
    "start": 90.7079365079365,
    "duration": 3.2499773242630385
  },
  {
    "id": 25,
    "text": "다른 하나는 그 방울이 흩뜨린 빛을 읽고 있었던 겁니다.",
    "start": 93.95791383219954,
    "duration": 4.083310657596372
  }
]