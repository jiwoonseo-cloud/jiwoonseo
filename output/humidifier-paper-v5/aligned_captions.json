[
  {
    "text": "초음파 가습기를 켰더니,",
    "start": 0.0,
    "end": 1.6
  },
  {
    "text": "공기청정기가 빨갛게 변합니다.",
    "start": 1.6,
    "end": 4.3
  },
  {
    "text": "맑은 물만 넣었는데,",
    "start": 4.72,
    "end": 5.98
  },
  {
    "text": "먼지는 대체 어디서",
    "start": 5.98,
    "end": 7.9
  },
  {
    "text": "나온 걸까요?",
    "start": 7.9,
    "end": 8.42
  },
  {
    "text": "먼저 저 하얀",
    "start": 9.0,
    "end": 10.14
  },
  {
    "text": "분무를 확대해보죠.",
    "start": 10.14,
    "end": 11.34
  },
  {
    "text": "초음파 가습기는 물을",
    "start": 11.8,
    "end": 13.22
  },
  {
    "text": "진동시켜 아주 작은",
    "start": 13.22,
    "end": 15.14
  },
  {
    "text": "물방울로 쪼개 날려",
    "start": 15.14,
    "end": 16.587
  },
  {
    "text": "보냅니다.",
    "start": 16.587,
    "end": 17.08
  },
  {
    "text": "눈앞에 떠 있는",
    "start": 17.54,
    "end": 18.2
  },
  {
    "text": "건 기체인 수증기가",
    "start": 18.2,
    "end": 19.82
  },
  {
    "text": "아니라, 작은 액체",
    "start": 19.82,
    "end": 21.74
  },
  {
    "text": "방울들이에요.",
    "start": 21.74,
    "end": 22.36
  },
  {
    "text": "이 물방울이 공기청정기의",
    "start": 23.02,
    "end": 24.845
  },
  {
    "text": "먼지 센서로 들어갑니다.",
    "start": 24.82,
    "end": 26.36
  },
  {
    "text": "광학식 센서 안에는",
    "start": 26.85,
    "end": 28.04
  },
  {
    "text": "빛이 지나가는 통로가",
    "start": 28.04,
    "end": 29.58
  },
  {
    "text": "있습니다.",
    "start": 29.58,
    "end": 29.84
  },
  {
    "text": "먼지 같은 입자가",
    "start": 30.72,
    "end": 32.04
  },
  {
    "text": "그 빛을 지나면",
    "start": 32.04,
    "end": 33.1
  },
  {
    "text": "빛이 사방으로 흩어지고,",
    "start": 33.1,
    "end": 35.14
  },
  {
    "text": "센서는 그 신호를",
    "start": 35.14,
    "end": 36.7
  },
  {
    "text": "이용해 먼지 농도를",
    "start": 36.7,
    "end": 38.12
  },
  {
    "text": "계산하죠.",
    "start": 38.12,
    "end": 38.7
  },
  {
    "text": "그런데 물방울도 빛을",
    "start": 39.28,
    "end": 41.0
  },
  {
    "text": "흩뜨립니다.",
    "start": 41.0,
    "end": 41.52
  },
  {
    "text": "센서가 그 성분까지",
    "start": 42.32,
    "end": 43.66
  },
  {
    "text": "검사하는 건 아니거든요.",
    "start": 43.66,
    "end": 44.96
  },
  {
    "text": "그래서 가습기가 내보낸",
    "start": 46.02,
    "end": 47.46
  },
  {
    "text": "물방울 때문에, 표시창의",
    "start": 47.46,
    "end": 49.46
  },
  {
    "text": "먼지 수치가 올라갈",
    "start": 49.46,
    "end": 51.04
  },
  {
    "text": "수 있습니다.",
    "start": 51.04,
    "end": 51.58
  },
  {
    "text": "그럼 물방울이 마르면",
    "start": 52.28,
    "end": 53.64
  },
  {
    "text": "전부 사라질까요?",
    "start": 53.64,
    "end": 54.94
  },
  {
    "text": "여기서 물속에 녹아",
    "start": 55.26,
    "end": 56.95
  },
  {
    "text": "있던 성분이 등장합니다.",
    "start": 56.95,
    "end": 58.26
  },
  {
    "text": "수돗물에는 칼슘 같은",
    "start": 58.79,
    "end": 60.18
  },
  {
    "text": "미네랄이 녹아 있어요.",
    "start": 60.18,
    "end": 61.58
  },
  {
    "text": "초음파 가습기는 물만",
    "start": 62.66,
    "end": 64.58
  },
  {
    "text": "골라 내보내지 않습니다.",
    "start": 64.58,
    "end": 66.14
  },
  {
    "text": "물방울에 실린 미네랄도",
    "start": 66.66,
    "end": 68.24
  },
  {
    "text": "함께 공기 중으로",
    "start": 68.24,
    "end": 69.68
  },
  {
    "text": "나갈 수 있죠.",
    "start": 69.68,
    "end": 70.4
  },
  {
    "text": "이때 물이 증발하면,",
    "start": 71.08,
    "end": 72.26
  },
  {
    "text": "미네랄은 작은 고체",
    "start": 72.26,
    "end": 74.4
  },
  {
    "text": "입자로 남을 수",
    "start": 74.4,
    "end": 75.22
  },
  {
    "text": "있습니다.",
    "start": 75.22,
    "end": 75.66
  },
  {
    "text": "젖어 있을 땐",
    "start": 76.14,
    "end": 76.92
  },
  {
    "text": "안 보이던 물자국이,",
    "start": 76.92,
    "end": 78.34
  },
  {
    "text": "마르고 나면 하얗게",
    "start": 78.34,
    "end": 80.18
  },
  {
    "text": "남는 것처럼요.",
    "start": 80.18,
    "end": 81.04
  },
  {
    "text": "처음의 빨간불로 돌아가",
    "start": 81.5,
    "end": 83.06
  },
  {
    "text": "보죠.",
    "start": 83.06,
    "end": 83.38
  },
  {
    "text": "물방울 자체가 센서에",
    "start": 83.94,
    "end": 85.76
  },
  {
    "text": "잡히는 것과,",
    "start": 85.76,
    "end": 86.6
  },
  {
    "text": "물이 마른 뒤",
    "start": 86.6,
    "end": 88.12
  },
  {
    "text": "입자가 남는 것은",
    "start": 88.12,
    "end": 89.4
  },
  {
    "text": "서로 다른 과정입니다.",
    "start": 89.4,
    "end": 90.98
  },
  {
    "text": "표시창의 숫자만으로 그",
    "start": 91.96,
    "end": 94.0
  },
  {
    "text": "성분이나 위험성까지 알",
    "start": 94.0,
    "end": 95.66
  },
  {
    "text": "수는 없어요.",
    "start": 95.66,
    "end": 96.32
  },
  {
    "text": "하지만 두 기기가",
    "start": 96.94,
    "end": 98.12
  },
  {
    "text": "왜 충돌하는 것처럼",
    "start": 98.12,
    "end": 99.52
  },
  {
    "text": "보이는지는 분명해집니다.",
    "start": 99.52,
    "end": 101.38
  },
  {
    "text": "하나는 물을 작은",
    "start": 101.84,
    "end": 103.36
  },
  {
    "text": "방울로 만들어 내보내고,",
    "start": 103.36,
    "end": 104.94
  },
  {
    "text": "다른 하나는 그",
    "start": 104.94,
    "end": 106.58
  },
  {
    "text": "방울이 흩뜨린 빛을",
    "start": 106.58,
    "end": 107.94
  },
  {
    "text": "읽고 있었던 겁니다.",
    "start": 107.945,
    "end": 108.88
  }
]