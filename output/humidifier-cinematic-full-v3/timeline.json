[
  {
    "index": 0,
    "text": "초음파 가습기를 켰더니, 공기청정기가 빨갛게 변합니다.",
    "start": 0,
    "speech_end": 5.363809523809524,
    "end": 5.623809523809523,
    "captions": [
      {
        "text": "초음파 가습기를 켰더니,",
        "start": 0.15092970430850983,
        "end": 2.2523356042802334
      },
      {
        "text": "공기청정기가 빨갛게",
        "start": 2.2523356042802334,
        "end": 3.9938322231173515
      },
      {
        "text": "변합니다.",
        "start": 3.9938322231173515,
        "end": 5.143219981342554
      }
    ]
  },
  {
    "index": 1,
    "text": "맑은 물만 넣었는데, 먼지는 대체 어디서 나온 걸까요?",
    "start": 5.623809523809523,
    "speech_end": 10.836689342403627,
    "end": 11.336689342403627,
    "captions": [
      {
        "text": "맑은 물만 넣었는데,",
        "start": 5.786349210817189,
        "end": 7.632335614342065
      },
      {
        "text": "먼지는 대체 어디서",
        "start": 7.632335614342065,
        "end": 9.130022697079749
      },
      {
        "text": "나온 걸까요?",
        "start": 9.130022697079749,
        "end": 10.627709783542723
      }
    ]
  },
  {
    "index": 2,
    "text": "먼저 저 하얀 분무를 확대해보죠.",
    "start": 11.336689342403627,
    "speech_end": 14.645532879818592,
    "end": 14.905532879818592,
    "captions": [
      {
        "text": "먼저 저 하얀",
        "start": 11.499229029411293,
        "end": 12.555736978197313
      },
      {
        "text": "분무를 확대해보죠.",
        "start": 12.555736978197313,
        "end": 14.378503431225038
      }
    ]
  },
  {
    "index": 3,
    "text": "초음파 가습기는 물을 진동시켜 아주 작은 물방울로 쪼개 날려 보냅니다.",
    "start": 14.905532879818594,
    "speech_end": 20.989160997732426,
    "end": 21.249160997732428,
    "captions": [
      {
        "text": "초음파 가습기는 물을",
        "start": 15.06807256310097,
        "end": 16.60058959021083
      },
      {
        "text": "진동시켜 아주 작은",
        "start": 16.60058959021083,
        "end": 18.23759640573374
      },
      {
        "text": "물방울로 쪼개 날려",
        "start": 18.23759640573374,
        "end": 19.64240367530695
      },
      {
        "text": "보냅니다.",
        "start": 19.64240367530695,
        "end": 20.710521591890966
      }
    ]
  },
  {
    "index": 4,
    "text": "눈앞에 떠 있는 건 기체인 수증기가 아니라, 작은 액체 방울들이에요.",
    "start": 21.249160997732425,
    "speech_end": 27.065759637188208,
    "end": 27.565759637188208,
    "captions": [
      {
        "text": "눈앞에 떠 있는",
        "start": 21.41170068474009,
        "end": 22.34049887598946
      },
      {
        "text": "건 기체인 수증기가",
        "start": 22.34049887598946,
        "end": 23.687256258143925
      },
      {
        "text": "아니라, 작은 액체",
        "start": 23.687256258143925,
        "end": 25.38231296108558
      },
      {
        "text": "방울들이에요.",
        "start": 25.38231296108558,
        "end": 26.81034015507891
      }
    ]
  },
  {
    "index": 5,
    "text": "이 물방울이 공기청정기의 먼지 센서로 들어갑니다.",
    "start": 27.565759637188208,
    "speech_end": 32.023990929705214,
    "end": 32.28399092970521,
    "captions": [
      {
        "text": "이 물방울이 공기청정기의",
        "start": 27.693469387274277,
        "end": 29.609115660917055
      },
      {
        "text": "먼지 센서로 들어갑니다.",
        "start": 29.609115660917055,
        "end": 31.75696147678424
      }
    ]
  },
  {
    "index": 6,
    "text": "광학식 센서 안에는 빛이 지나가는 통로가 있습니다.",
    "start": 32.28399092970521,
    "speech_end": 36.788662131519274,
    "end": 37.04866213151927,
    "captions": [
      {
        "text": "광학식 센서 안에는",
        "start": 32.43492063401372,
        "end": 33.95582768214972
      },
      {
        "text": "빛이 지나가는 통로가",
        "start": 33.95582768214972,
        "end": 35.44190479336412
      },
      {
        "text": "있습니다.",
        "start": 35.44190479336412,
        "end": 36.56807260854275
      }
    ]
  },
  {
    "index": 7,
    "text": "먼지 같은 입자가 그 빛을 지나면 빛이 사방으로 흩어지고,",
    "start": 37.04866213151927,
    "speech_end": 42.0641723356009,
    "end": 42.3241723356009,
    "captions": [
      {
        "text": "먼지 같은 입자가",
        "start": 37.19959183955307,
        "end": 38.499909313262656
      },
      {
        "text": "그 빛을 지나면",
        "start": 38.499909313262656,
        "end": 39.75378687107678
      },
      {
        "text": "빛이 사방으로 흩어지고,",
        "start": 39.75378687107678,
        "end": 41.76231295788403
      }
    ]
  },
  {
    "index": 8,
    "text": "센서는 그 신호를 이용해 먼지 농도를 계산하죠.",
    "start": 42.324172335600906,
    "speech_end": 46.689523809523806,
    "end": 47.189523809523806,
    "captions": [
      {
        "text": "센서는 그 신호를",
        "start": 42.498321990406566,
        "end": 43.77541950616842
      },
      {
        "text": "이용해 먼지 농도를",
        "start": 43.77541950616842,
        "end": 45.2731065889061
      },
      {
        "text": "계산하죠.",
        "start": 45.2731065889061,
        "end": 46.399274385458284
      }
    ]
  },
  {
    "index": 9,
    "text": "그런데 물방울도 빛을 흩뜨립니다.",
    "start": 47.189523809523806,
    "speech_end": 50.56802721088435,
    "end": 50.82802721088435,
    "captions": [
      {
        "text": "그런데 물방울도 빛을",
        "start": 47.317233559609875,
        "end": 49.08195012521885
      },
      {
        "text": "흩뜨립니다.",
        "start": 49.08195012521885,
        "end": 50.30099774983667
      }
    ]
  },
  {
    "index": 10,
    "text": "센서가 그 성분까지 검사하는 건 아니거든요.",
    "start": 50.82802721088435,
    "speech_end": 55.06566893424036,
    "end": 55.325668934240355,
    "captions": [
      {
        "text": "센서가 그 성분까지",
        "start": 51.00217686569001,
        "end": 52.5230839175513
      },
      {
        "text": "검사하는 건 아니거든요.",
        "start": 52.5230839175513,
        "end": 54.79863947605397
      }
    ]
  },
  {
    "index": 11,
    "text": "그래서 가습기가 내보낸 물방울 때문에, 표시창의 먼지 수치가 올라갈 수 있습니다.",
    "start": 55.32566893424036,
    "speech_end": 61.838866213151924,
    "end": 62.338866213151924,
    "captions": [
      {
        "text": "그래서 가습기가 내보낸",
        "start": 55.45337868432643,
        "end": 57.078775532051345
      },
      {
        "text": "물방울 때문에, 표시창의",
        "start": 57.078775532051345,
        "end": 59.052471681937
      },
      {
        "text": "먼지 수치가 올라갈",
        "start": 59.052471681937,
        "end": 60.37600909869315
      },
      {
        "text": "수 있습니다.",
        "start": 60.37600909869315,
        "end": 61.548616807415506
      }
    ]
  },
  {
    "index": 12,
    "text": "그럼 물방울이 마르면 전부 사라질까요?",
    "start": 62.338866213151924,
    "speech_end": 66.12371882086167,
    "end": 66.38371882086167,
    "captions": [
      {
        "text": "그럼 물방울이 마르면",
        "start": 62.46657596323799,
        "end": 64.1268027143569
      },
      {
        "text": "전부 사라질까요?",
        "start": 64.1268027143569,
        "end": 65.94956915993404
      }
    ]
  },
  {
    "index": 13,
    "text": "여기서 물속에 녹아 있던 성분이 등장합니다.",
    "start": 66.38371882086167,
    "speech_end": 70.43560090702948,
    "end": 70.93560090702948,
    "captions": [
      {
        "text": "여기서 물속에 녹아",
        "start": 66.52303854619632,
        "end": 67.96267574151526
      },
      {
        "text": "있던 성분이 등장합니다.",
        "start": 67.96267574151526,
        "end": 70.22662132476935
      }
    ]
  },
  {
    "index": 14,
    "text": "수돗물에는 칼슘 같은 미네랄이 녹아 있어요.",
    "start": 70.93560090702948,
    "speech_end": 74.9526530612245,
    "end": 75.2126530612245,
    "captions": [
      {
        "text": "수돗물에는 칼슘 같은",
        "start": 71.09814059031186,
        "end": 72.76997733530578
      },
      {
        "text": "미네랄이 녹아 있어요.",
        "start": 72.76997733530578,
        "end": 74.70884354826984
      }
    ]
  },
  {
    "index": 15,
    "text": "초음파 가습기는 물만 골라 내보내지 않습니다.",
    "start": 75.21265306122449,
    "speech_end": 79.40385487528344,
    "end": 79.66385487528345,
    "captions": [
      {
        "text": "초음파 가습기는 물만",
        "start": 75.36358276925829,
        "end": 77.0818594189718
      },
      {
        "text": "골라 내보내지 않습니다.",
        "start": 77.0818594189718,
        "end": 79.19487531281855
      }
    ]
  },
  {
    "index": 16,
    "text": "물방울에 실린 미네랄도 함께 공기 중으로 나갈 수 있죠.",
    "start": 79.66385487528345,
    "speech_end": 84.3891156462585,
    "end": 84.8891156462585,
    "captions": [
      {
        "text": "물방울에 실린 미네랄도",
        "start": 79.81478457586667,
        "end": 81.50984127135774
      },
      {
        "text": "함께 공기 중으로",
        "start": 81.50984127135774,
        "end": 82.752108850198
      },
      {
        "text": "나갈 수 있죠.",
        "start": 82.752108850198,
        "end": 84.09886621372601
      }
    ]
  },
  {
    "index": 17,
    "text": "이때 물이 증발하면, 미네랄은 작은 고체 입자로 남을 수 있습니다.",
    "start": 84.8891156462585,
    "speech_end": 90.6360544217687,
    "end": 90.89605442176871,
    "captions": [
      {
        "text": "이때 물이 증발하면,",
        "start": 85.01682539634457,
        "end": 86.85120181717029
      },
      {
        "text": "미네랄은 작은 고체",
        "start": 86.85120181717029,
        "end": 88.2560090867435
      },
      {
        "text": "입자로 남을 수",
        "start": 88.2560090867435,
        "end": 89.33573698602667
      },
      {
        "text": "있습니다.",
        "start": 89.33573698602667,
        "end": 90.45029481478086
      }
    ]
  },
  {
    "index": 18,
    "text": "젖어 있을 땐 안 보이던 물자국이, 마르고 나면 하얗게 남는 것처럼요.",
    "start": 90.89605442176871,
    "speech_end": 97.01451247165534,
    "end": 97.51451247165534,
    "captions": [
      {
        "text": "젖어 있을 땐",
        "start": 91.03537414710335,
        "end": 91.92934240515642
      },
      {
        "text": "안 보이던 물자국이,",
        "start": 91.92934240515642,
        "end": 93.74049887548499
      },
      {
        "text": "마르고 나면 하얗게",
        "start": 93.74049887548499,
        "end": 95.2265759829741
      },
      {
        "text": "남는 것처럼요.",
        "start": 95.2265759829741,
        "end": 96.8287528653007
      }
    ]
  },
  {
    "index": 19,
    "text": "처음의 빨간불로 돌아가 보죠.",
    "start": 97.51451247165534,
    "speech_end": 100.45183673469388,
    "end": 100.71183673469389,
    "captions": [
      {
        "text": "처음의 빨간불로 돌아가",
        "start": 97.66544217968914,
        "end": 99.30244899893734
      },
      {
        "text": "보죠.",
        "start": 99.30244899893734,
        "end": 100.24285716170999
      }
    ]
  },
  {
    "index": 20,
    "text": "물방울 자체가 센서에 잡히는 것과,",
    "start": 100.71183673469389,
    "speech_end": 103.99746031746032,
    "end": 104.25746031746033,
    "captions": [
      {
        "text": "물방울 자체가 센서에",
        "start": 100.87437642170156,
        "end": 102.40689344508613
      },
      {
        "text": "잡히는 것과,",
        "start": 102.40689344508613,
        "end": 103.70721090761984
      }
    ]
  },
  {
    "index": 21,
    "text": "물이 마른 뒤 입자가 남는 것은 서로 다른 과정입니다.",
    "start": 104.25746031746033,
    "speech_end": 108.82018140589571,
    "end": 109.08018140589571,
    "captions": [
      {
        "text": "물이 마른 뒤",
        "start": 104.40839002549413,
        "end": 105.12820862129095
      },
      {
        "text": "입자가 남는 것은",
        "start": 105.12820862129095,
        "end": 106.62589570775393
      },
      {
        "text": "서로 다른 과정입니다.",
        "start": 106.62589570775393,
        "end": 108.587981882391
      }
    ]
  },
  {
    "index": 22,
    "text": "표시창의 숫자만으로 그 성분이나 위험성까지 알 수는 없어요.",
    "start": 109.0801814058957,
    "speech_end": 114.14213151927439,
    "end": 114.64213151927439,
    "captions": [
      {
        "text": "표시창의 숫자만으로",
        "start": 109.21950113123034,
        "end": 110.64752834757542
      },
      {
        "text": "그 성분이나 위험성까지",
        "start": 110.64752834757542,
        "end": 112.27292518412446
      },
      {
        "text": "알 수는 없어요.",
        "start": 112.27292518412446,
        "end": 113.88671202679848
      }
    ]
  },
  {
    "index": 23,
    "text": "하지만 두 기기가 왜 충돌하는 것처럼 보이는지는 분명해집니다.",
    "start": 114.64213151927439,
    "speech_end": 119.97111111111113,
    "end": 120.23111111111113,
    "captions": [
      {
        "text": "하지만 두 기기가",
        "start": 114.78145124460903,
        "end": 116.11659864778963
      },
      {
        "text": "왜 충돌하는 것처럼",
        "start": 116.11659864778963,
        "end": 117.49818595941511
      },
      {
        "text": "보이는지는 분명해집니다.",
        "start": 117.49818595941511,
        "end": 119.70408167387691
      }
    ]
  },
  {
    "index": 24,
    "text": "하나는 물을 작은 방울로 만들어 내보내고,",
    "start": 120.23111111111112,
    "speech_end": 123.92308390022677,
    "end": 124.18308390022678,
    "captions": [
      {
        "text": "하나는 물을 작은",
        "start": 120.37043083644576,
        "end": 121.58947846851416
      },
      {
        "text": "방울로 만들어 내보내고,",
        "start": 121.58947846851416,
        "end": 123.71410431898303
      }
    ]
  },
  {
    "index": 25,
    "text": "다른 하나는 그 방울이 흩뜨린 빛을 읽고 있었던 겁니다.",
    "start": 124.18308390022676,
    "speech_end": 128.87351473922902,
    "end": 129.133514739229,
    "captions": [
      {
        "text": "다른 하나는 그",
        "start": 124.3224036292867,
        "end": 125.39052154587071
      },
      {
        "text": "방울이 흩뜨린 빛을",
        "start": 125.39052154587071,
        "end": 126.73727893175047
      },
      {
        "text": "읽고 있었던 겁니다.",
        "start": 126.73727893175047,
        "end": 128.6297052548961
      }
    ]
  }
]