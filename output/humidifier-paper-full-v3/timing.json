[
  {
    "index": 0,
    "text": "초음파 가습기를 켰더니, 공기청정기가 빨갛게 변합니다.",
    "start": 0.35,
    "end": 6.313038548752834,
    "duration": 5.963038548752834
  },
  {
    "index": 1,
    "text": "맑은 물만 넣었는데, 먼지는 대체 어디서 나온 걸까요?",
    "start": 6.593038548752834,
    "end": 12.672176870748299,
    "duration": 6.0791383219954644
  },
  {
    "index": 2,
    "text": "먼저 저 하얀 분무를 확대해보죠.",
    "start": 12.9521768707483,
    "end": 16.299410430839004,
    "duration": 3.347233560090703
  },
  {
    "index": 3,
    "text": "초음파 가습기는 물을 진동시켜 아주 작은 물방울로 쪼개 날려 보냅니다.",
    "start": 16.579410430839005,
    "end": 22.736258503401363,
    "duration": 6.156848072562358
  },
  {
    "index": 4,
    "text": "눈앞에 떠 있는 건 기체인 수증기가 아니라, 작은 액체 방울들이에요.",
    "start": 23.016258503401364,
    "end": 29.699115646258505,
    "duration": 6.682857142857143
  },
  {
    "index": 5,
    "text": "이 물방울이 공기청정기의 먼지 센서로 들어갑니다.",
    "start": 29.979115646258506,
    "end": 34.522176870748304,
    "duration": 4.543061224489796
  },
  {
    "index": 6,
    "text": "광학식 센서 안에는 빛이 지나가는 통로가 있습니다.",
    "start": 34.802176870748305,
    "end": 39.31040816326531,
    "duration": 4.5082312925170065
  },
  {
    "index": 7,
    "text": "먼지 같은 입자가 그 빛을 지나면 빛이 사방으로 흩어지고,",
    "start": 39.59040816326531,
    "end": 44.60947845804989,
    "duration": 5.019070294784581
  },
  {
    "index": 8,
    "text": "센서는 그 신호를 이용해 먼지 농도를 계산하죠.",
    "start": 44.889478458049894,
    "end": 49.24678004535148,
    "duration": 4.3573015873015875
  },
  {
    "index": 9,
    "text": "그런데 물방울도 빛을 흩뜨립니다.",
    "start": 49.52678004535148,
    "end": 53.00172335600907,
    "duration": 3.474943310657596
  },
  {
    "index": 10,
    "text": "센서가 그 성분까지 검사하는 건 아니거든요.",
    "start": 53.281723356009074,
    "end": 57.511315192743766,
    "duration": 4.229591836734694
  },
  {
    "index": 11,
    "text": "그래서 가습기가 내보낸 물방울 때문에, 표시창의 먼지 수치가 올라갈 수 있습니다.",
    "start": 57.79131519274377,
    "end": 65.18238095238095,
    "duration": 7.391065759637188
  },
  {
    "index": 12,
    "text": "그럼 물방울이 마르면 전부 사라질까요?",
    "start": 65.46238095238095,
    "end": 69.27401360544218,
    "duration": 3.8116326530612246
  },
  {
    "index": 13,
    "text": "여기서 물속에 녹아 있던 성분이 등장합니다.",
    "start": 69.55401360544218,
    "end": 73.66750566893424,
    "duration": 4.113492063492063
  },
  {
    "index": 14,
    "text": "수돗물에는 칼슘 같은 미네랄이 녹아 있어요.",
    "start": 73.94750566893424,
    "end": 78.00294784580498,
    "duration": 4.0554421768707485
  },
  {
    "index": 15,
    "text": "초음파 가습기는 물만 골라 내보내지 않습니다.",
    "start": 78.28294784580498,
    "end": 82.58219954648526,
    "duration": 4.299251700680272
  },
  {
    "index": 16,
    "text": "물방울에 실린 미네랄도 함께 공기 중으로 나갈 수 있죠.",
    "start": 82.86219954648526,
    "end": 87.6722902494331,
    "duration": 4.8100907029478455
  },
  {
    "index": 17,
    "text": "이때 물이 증발하면, 미네랄은 작은 고체 입자로 남을 수 있습니다.",
    "start": 87.9522902494331,
    "end": 94.63514739229025,
    "duration": 6.682857142857143
  },
  {
    "index": 18,
    "text": "젖어 있을 땐 안 보이던 물자국이, 마르고 나면 하얗게 남는 것처럼요.",
    "start": 94.91514739229025,
    "end": 101.86503401360544,
    "duration": 6.949886621315192
  },
  {
    "index": 19,
    "text": "처음의 빨간불로 돌아가 보죠.",
    "start": 102.14503401360544,
    "end": 105.15557823129251,
    "duration": 3.010544217687075
  },
  {
    "index": 20,
    "text": "물방울 자체가 센서에 잡히는 것과,",
    "start": 105.43557823129251,
    "end": 108.87569160997732,
    "duration": 3.4401133786848073
  },
  {
    "index": 21,
    "text": "물이 마른 뒤 입자가 남는 것은 서로 다른 과정입니다.",
    "start": 109.15569160997731,
    "end": 113.6987528344671,
    "duration": 4.543061224489796
  },
  {
    "index": 22,
    "text": "표시창의 숫자만으로 그 성분이나 위험성까지 알 수는 없어요.",
    "start": 113.9787528344671,
    "end": 119.1487528344671,
    "duration": 5.17
  },
  {
    "index": 23,
    "text": "하지만 두 기기가 왜 충돌하는 것처럼 보이는지는 분명해집니다.",
    "start": 119.4287528344671,
    "end": 124.83095238095237,
    "duration": 5.402199546485261
  },
  {
    "index": 24,
    "text": "하나는 물을 작은 방울로 만들어 내보내고,",
    "start": 125.11095238095237,
    "end": 128.86453514739227,
    "duration": 3.7535827664399095
  },
  {
    "index": 25,
    "text": "다른 하나는 그 방울이 흩뜨린 빛을 읽고 있었던 겁니다.",
    "start": 129.14453514739228,
    "end": 133.94301587301587,
    "duration": 4.798480725623583
  }
]